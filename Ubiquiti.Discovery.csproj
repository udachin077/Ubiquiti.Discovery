<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<PackageId>Ubiquiti.Discovery</PackageId>
		<Version>1.0.1</Version>
		<Description>A lightweight .NET library that discovers Ubiquiti devices on the local network via UDP broadcast (port 10001). Provides streaming discovery through IAsyncEnumerable, device deduplication by MAC address, TLV response parsing and optional dependency-injection integration.</Description>
		<PackageTags>ubiquiti;airos;discovery</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/udachin077/Uibiquiti.Discovery</PackageProjectUrl>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>Ubiquiti.Discovery</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0" />
		<PackageReference Include="Microsoft.Extensions.Options" Version="11.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>